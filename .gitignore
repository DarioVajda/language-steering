.venv/
__pycache__/
data/raw_data/*/.cache/
data/hidden_states/
logs/
src/experiments/word_level_analysis/states/

# regenerable data (src/data/download.py, preprocess.py; src/icl/vectors.py)
data/raw_data/*
!data/raw_data/manifest.json
data/processed_data/*.jsonl
data/language_vectors/
src/experiments/word_level_analysis/results/alignments_*.json
src/experiments/*/scratch/

# per-item predictions and val shards; summary.json and tuning.json are kept
src/icl/results/**/test_predictions.jsonl
src/icl/results/**/val*.jsonl

# output-language experiment: per-item generations (regenerable); results/summary.json is kept
src/experiments/output_language/results/generations/

# language-confusion experiment: per-item generations (regenerable); results/<model>/summary*.json are kept
src/experiments/language_confusion/results/*/generations/

# MGSM steering experiment: per-item generations, vectors, claims (regenerable); results/summary.json is kept
src/experiments/mgsm_steering/results/generations/

# cross-lingual MGSM experiment: per-item generations, vectors, claims (regenerable); results/*.json are kept
src/experiments/mgsm_crosslingual/results/*/generations/

# Related-work notes (local only)
/LITERATURE.md
/docs/related_work/

# MMLU-ProX experiment: per-item generations and claims, and the per-question scores of tests.py (regenerable);
# the other results/<model>/*.json are kept
src/experiments/mmlu_prox/results/*/generations/
src/experiments/mmlu_prox/results/*/*_items.json

# Paper: its own repo (github.com/DarioVajda/MLLP-Project, synced with Overleaf)
/paper/
